{
    "name": "httpant",
    "version": "0.2.0",
    "dependencies": [
        "llhttp",
        "nghttp2",
        "nghttp3",
        "stdexec",
        "asio",
        "bext-ut"
    ],
    "features": {
        "quic": {
            "description": "Build QUIC streams with msquic and engine posts (module httpant.quic).",
            "dependencies": [
                "msquic"
            ]
        },
        "uring": {
            "supports": "linux",
            "description": "Build the Linux io_uring engine",
            "dependencies": [
                {
                    "name": "liburing",
                    "platform": "linux"
                }
            ]
        },
        "tls": {
            "description": "Build httpant.tls over caller transports with wolfSSL.",
            "dependencies": [
                "wolfssl"
            ]
        }
    }
}
