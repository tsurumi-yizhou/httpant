@PACKAGE_INIT@

# httpant's modules as sources: this config registers the same targets the
# repository builds (httpant::httpant, httpant::io, ...) and the consumer's
# build compiles them, since module BMIs are not portable across compilers or
# standard libraries. The optional parts are the ones this package was built
# with, including the I/O mechanism.
include(CMakeFindDependencyMacro)
find_dependency(xclang CONFIG)

if(NOT TARGET httpant::httpant)
  set(HTTPANT_BUILD_SUPPORT OFF)
  set(HTTPANT_ENABLE_TLS @HTTPANT_ENABLE_TLS@)
  set(HTTPANT_ENABLE_IO @HTTPANT_ENABLE_IO@)
  set(HTTPANT_ENABLE_QUIC @HTTPANT_ENABLE_QUIC@)
  set(HTTPANT_IO_BACKEND @HTTPANT_IO_BACKEND@)
  set(HTTPANT_SOURCE "@PACKAGE_HTTPANT_INSTALL_SHARE@")
  include("${CMAKE_CURRENT_LIST_DIR}/dependencies.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/modules.cmake")
endif()

check_required_components(httpant)
